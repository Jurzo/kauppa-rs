# CODEOWNERS enforces human approval on the governance surface and on
# escalation-trigger paths. It owns every trigger path in
# scripts/agentic/check_triggers.py and .agentic/runbooks/feature.md, and
# names only the accounts in check_triggers.py's OWNERS:
# scripts/agentic/test_check_triggers.sh checks both (RR-0027).

# Governance artifacts: humans only.
/AGENTS.md                     @Jurzo
/.agentic/mentorship/          @Jurzo
/.agentic/runbooks/            @Jurzo
/.agentic/resolutions/         @Jurzo
/.agentic/schemas/             @Jurzo

# Data: schema is append-only, every change via the migration runbook.
/migrations/                   @Jurzo

# Security: auth, sessions, password hashing.
/crates/kauppa-core/src/password.rs           @Jurzo
/crates/kauppa-web/src/routes/auth/          @Jurzo
/crates/kauppa-web/src/routes/admin/         @Jurzo
/crates/kauppa-web/src/admin/                @Jurzo
/crates/kauppa-web/src/main.rs                @Jurzo

# Security: shared-list authorization (RR-0002).
/crates/kauppa-web/src/routes/lists/          @Jurzo
/crates/kauppa-core/src/repo/sqlite/list.rs   @Jurzo
/crates/kauppa-core/src/repo/sqlite/list_access.rs @Jurzo

# Security: cross-site check, headers, settings, language cookie (RR-0027).
/crates/kauppa-web/src/csrf/                  @Jurzo
/crates/kauppa-web/src/csp.rs                 @Jurzo
/crates/kauppa-web/src/config.rs              @Jurzo
/crates/kauppa-web/src/i18n/request.rs        @Jurzo
/crates/kauppa-web/src/routes/language.rs     @Jurzo

# Platform: build, deps, lint config, CI, scripts.
/Cargo.toml                    @Jurzo
/crates/*/Cargo.toml           @Jurzo
/rust-toolchain.toml           @Jurzo
/rustfmt.toml                  @Jurzo
/deny.toml                     @Jurzo
/.github/                      @Jurzo
/scripts/agentic/              @Jurzo

# Platform: deployment (RR-0014, RR-0027). Not deploy/README.md.
/deploy/Dockerfile             @Jurzo
/deploy/compose.yaml           @Jurzo
/deploy/Caddyfile              @Jurzo
/deploy/docker-entrypoint.sh   @Jurzo
/deploy/terraform/             @Jurzo
/deploy/backup/                @Jurzo
