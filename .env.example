# Copy to .env for local dev.
# All vars are read with the prefix `KAUPPA_` (single underscore).

KAUPPA_BIND=127.0.0.1:8080
KAUPPA_DATABASE_URL=sqlite://data/kauppa.db
KAUPPA_LOG_LEVEL=info,kauppa_web=debug,kauppa_core=debug

# MUST be >=64 bytes. Generate with:
#   openssl rand -base64 64 | tr -d '\n' | cut -c1-64
KAUPPA_SESSION_SECRET=dev-only-dev-only-dev-only-dev-only-dev-only-dev-only-dev-only-01

# Set to true behind HTTPS termination.
KAUPPA_COOKIE_SECURE=false
