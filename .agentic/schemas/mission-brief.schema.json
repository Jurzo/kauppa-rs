{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kauppa-rs.local/schemas/mission-brief.schema.json",
  "title": "Mission Brief front matter",
  "type": "object",
  "required": ["id", "owner", "goal", "non_goals", "acceptance", "autonomy", "runbook", "mentorship"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MB-\\d{4,}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^@[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "property", "check"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^P\\d+$" },
          "property": { "type": "string", "minLength": 5 },
          "check": { "type": "string", "minLength": 3 }
        }
      }
    },
    "context": {
      "type": "array",
      "items": { "type": "string" }
    },
    "autonomy": {
      "type": "object",
      "required": ["may_decide", "escalate", "forbidden"],
      "additionalProperties": false,
      "properties": {
        "may_decide": {
          "type": "array",
          "items": { "type": "string" }
        },
        "escalate": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "to"],
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        },
        "forbidden": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "runbook": {
      "type": "string",
      "pattern": "^\\.agentic/runbooks/.+\\.md(@v\\d+)?$"
    },
    "mentorship": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "resolutions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^RR-\\d{4,}$" }
    }
  }
}
