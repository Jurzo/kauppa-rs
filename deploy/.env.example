# Settings for deploy/compose.yaml. Copy to deploy/.env on the droplet
# (git-ignored). Nothing here is a secret: the session secret and the backup
# key live in files under ${KAUPPA_DATA_ROOT}/secrets/ (RR-0014 Q3).

# The image to run: one sha-<commit> tag or a digest, never :main (RR-0014 Q1).
KAUPPA_IMAGE=ghcr.io/jurzo/kauppa-rs:sha-0000000

# The data volume's mount point (terraform output volume_mount).
KAUPPA_DATA_ROOT=/mnt/kauppa-data

# The site. KAUPPA_PUBLIC_ORIGIN is the one origin browsers use (RR-0010).
KAUPPA_DOMAIN=kauppa.example
KAUPPA_PUBLIC_ORIGIN=https://kauppa.example

# Your email for Let's Encrypt (expiry notices), or "internal" for Caddy's
# local CA (testing only).
KAUPPA_TLS=you@example.com

# Backup bucket (terraform output backup_bucket).
KAUPPA_BACKUP_BUCKET=kauppa-backups-CHANGE-ME
KAUPPA_BACKUP_ENDPOINT=ams3.digitaloceanspaces.com

# Optional.
# KAUPPA_LOG_LEVEL=info
# KAUPPA_HTTP_PORT=80
# KAUPPA_HTTPS_PORT=443
