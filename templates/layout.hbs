<!doctype html>
<html lang="{{html_lang}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {{!-- MB-0054 (RR-0034): the site's page background per colour scheme
    (design-system/README.md), so the mobile browser bar matches the page.
    These are site colours, not the icon's. MB-0055 (RR-0035 sub-answer 3):
    a chosen Light or Dark gives one; System gives both, keyed on the OS. --}}
    {{#if @root.request_theme}}{{#if (eq @root.request_theme "light")}}
    <meta name="theme-color" content="#fbf8f5" />
    {{else}}{{#if (eq @root.request_theme "dark")}}
    <meta name="theme-color" content="#121212" />
    {{else}}
    <meta name="theme-color" content="#fbf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    {{/if}}{{/if}}{{else}}
    <meta name="theme-color" content="#fbf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    {{/if}}
    <meta name="apple-mobile-web-app-title" content="kauppalista" />
    <title>{{page_title}} — kauppalista.app</title>
    {{!-- MB-0054 (RR-0034 sub-answers 2, 3 and 6): the app icons, from
    design-system/assets/, served from the icons folder under /assets/ only. The SVG follows
    the OS colour scheme; the ICO is for browsers that don't take SVG. --}}
    <link rel="icon" href="/assets/icons/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/manifest.webmanifest" />
    <link rel="stylesheet" href="/assets/app.css" />
    <meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false}' />
    <script src="/assets/vendor/htmx-2.0.11.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" defer></script>
    {{!-- MB-0029 (RR-0018, RR-0025): lets the login, register and
    create-invitation forms show their 4xx page under htmx. <body> declares
    the extension (htmx runs it only from the swap target upward, and a
    boosted form's target is <body>); only those forms carry
    hx-target-4xx="body", so nothing else changes. --}}
    <script src="/assets/vendor/response-targets-2.0.4.min.js" integrity="sha384-T41oglUPvXLGBVyRdZsVRxNWnOOqCynaPubjUVjxhsjFTKrFJGEMm3/0KGmNQ+Pg" defer></script>
  </head>
  <body hx-boost="true" hx-ext="response-targets">
    <header class="topbar">
      <a class="brand" href="/"><img class="brand-icon" src="/assets/icons/favicon.svg" alt="" width="28" height="28" />kauppalista.app</a>
      {{!-- MB-0040: on phones the nav is a native popover panel opened by
      the menu button (no JavaScript); on wide screens app.css shows it
      inline and hides both buttons. Boosted navigation swaps <body>, so
      choosing an entry leaves the panel closed. --}}
      <button type="button" class="nav-open" popovertarget="site-nav"><span class="nav-icon" aria-hidden="true">☰</span> {{t "nav.menu"}}</button>
      <nav id="site-nav" class="site-nav" popover aria-label="{{t "nav.label"}}">
        <button type="button" class="nav-close" popovertarget="site-nav" popovertargetaction="hide" aria-label="{{t "nav.close_menu"}}" autofocus>✕</button>
        <a href="/lists"{{#if page_nav}}{{#if (eq page_nav "lists")}} aria-current="page"{{/if}}{{/if}}>{{t "nav.lists"}}</a>
        <a href="/recipes"{{#if page_nav}}{{#if (eq page_nav "recipes")}} aria-current="page"{{/if}}{{/if}}>{{t "nav.recipes"}}</a>
        <a href="/favorites"{{#if page_nav}}{{#if (eq page_nav "favorites")}} aria-current="page"{{/if}}{{/if}}>{{t "nav.favorites"}}</a>
        <a href="/categories"{{#if page_nav}}{{#if (eq page_nav "categories")}} aria-current="page"{{/if}}{{/if}}>{{t "nav.categories"}}</a>
        {{#if page_signed_in}}
          <form method="post" action="/auth/logout" class="inline">
            <button type="submit" class="link">{{t "nav.sign_out"}}</button>
          </form>
        {{else}}
          <a href="/auth/login">{{t "nav.sign_in"}}</a>
        {{/if}}
        {{!-- MB-0055 (RR-0035): the theme switch, the navigation's last
        group, so it is inline (icons only) on wide screens and a headed group
        of labelled rows in the phone panel. Choosing a radio repaints the page
        at once: app.css keys the dark tokens on the checked radio's id
        (`:has()`), no script. htmx then saves it (204); without JavaScript the
        Save button posts the form and the answer returns here. The server
        checks the saved choice (`request_theme`, System by default). Icons are
        decoration; each option's label names it. --}}
        <form class="theme-switch" method="post" action="/theme" hx-post="/theme" hx-trigger="change" hx-swap="none">
          <input type="hidden" name="return" value="{{#if @root.request_path}}{{@root.request_path}}{{else}}/{{/if}}" />
          <fieldset>
            <legend>{{t "theme.label"}}</legend>
            <label class="theme-option" title="{{t "theme.system"}}">
              <input type="radio" name="theme" value="system" id="theme-system"{{#if @root.request_theme}}{{#unless (eq @root.request_theme "light")}}{{#unless (eq @root.request_theme "dark")}} checked{{/unless}}{{/unless}}{{else}} checked{{/if}} />
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
              <span class="theme-label">{{t "theme.system"}}</span>
            </label>
            <label class="theme-option" title="{{t "theme.light"}}">
              <input type="radio" name="theme" value="light" id="theme-light"{{#if @root.request_theme}}{{#if (eq @root.request_theme "light")}} checked{{/if}}{{/if}} />
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" /></svg>
              <span class="theme-label">{{t "theme.light"}}</span>
            </label>
            <label class="theme-option" title="{{t "theme.dark"}}">
              <input type="radio" name="theme" value="dark" id="theme-dark"{{#if @root.request_theme}}{{#if (eq @root.request_theme "dark")}} checked{{/if}}{{/if}} />
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
              <span class="theme-label">{{t "theme.dark"}}</span>
            </label>
          </fieldset>
          <noscript><button type="submit" class="button">{{t "common.save"}}</button></noscript>
        </form>
      </nav>
      {{!-- MB-0051 (RR-0031, amending RR-0023 sub-answer 7): the language
      selector, on every page. The button opens a native popover (no
      JavaScript; Escape or a click outside closes it) holding the one POST
      form: a plain POST (no boost), so the answer is a full page load and
      <html lang> updates. Each option is named in its own language; flags
      are decoration. app.css shows the short name on phones and the full
      name on wide screens, places the selector between the brand and the
      menu button on phones (`order`; here it follows the navigation, as
      wide screens show it), and shows the options inline where popover
      isn't supported. --}}
      <div class="lang">
        <button type="button" class="lang-open" popovertarget="lang-menu" aria-label="{{#if (eq (html_lang) "fi")}}{{t "language.current" name=(t "language.fi")}}{{else}}{{t "language.current" name=(t "language.en")}}{{/if}}">
          <img class="flag" src="/assets/flags/{{html_lang}}.svg" alt="" width="20" height="15" />
          {{#if (eq (html_lang) "fi")}}
            <span class="lang-short" aria-hidden="true">{{t "language.short.fi"}}</span>
            <span class="lang-full">{{t "language.fi"}}</span>
          {{else}}
            <span class="lang-short" aria-hidden="true">{{t "language.short.en"}}</span>
            <span class="lang-full">{{t "language.en"}}</span>
          {{/if}}
          <span class="lang-chevron" aria-hidden="true">▾</span>
        </button>
        <form id="lang-menu" class="lang-menu" popover method="post" action="/language" hx-boost="false" aria-label="{{t "language.label"}}">
          <input type="hidden" name="return" value="{{#if @root.request_path}}{{@root.request_path}}{{else}}/{{/if}}" />
          <button type="submit" name="lang" value="en" lang="en"{{#if (eq (html_lang) "en")}} aria-current="true"{{/if}}>
            <img class="flag" src="/assets/flags/en.svg" alt="" width="20" height="15" />
            <span class="lang-short" aria-hidden="true">{{t "language.short.en"}}</span>
            <span class="lang-full">{{t "language.en"}}</span>
            {{#if (eq (html_lang) "en")}}<span class="lang-check" aria-hidden="true">✓</span>{{/if}}
          </button>
          <button type="submit" name="lang" value="fi" lang="fi"{{#if (eq (html_lang) "fi")}} aria-current="true"{{/if}}>
            <img class="flag" src="/assets/flags/fi.svg" alt="" width="20" height="15" />
            <span class="lang-short" aria-hidden="true">{{t "language.short.fi"}}</span>
            <span class="lang-full">{{t "language.fi"}}</span>
            {{#if (eq (html_lang) "fi")}}<span class="lang-check" aria-hidden="true">✓</span>{{/if}}
          </button>
        </form>
      </div>
    </header>
    <main>
      {{> @partial-block}}
    </main>
  </body>
</html>
