<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1f6feb" />
    <title>{{page_title}} — kauppa</title>
    <link rel="manifest" href="/assets/manifest.webmanifest" />
    <link rel="stylesheet" href="/assets/app.css" />
    <meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false}' />
    <script src="/assets/vendor/htmx-2.0.11.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" defer></script>
    {{!-- MB-0029 (RR-0018, RR-0025): lets the login, register and
    create-invitation forms show their 4xx page under htmx. <body> declares
    the extension (htmx runs it only from the swap target upward, and a
    boosted form's target is <body>); only those forms carry
    hx-target-4xx="body", so nothing else changes. --}}
    <script src="/assets/vendor/response-targets-2.0.4.min.js" integrity="sha384-T41oglUPvXLGBVyRdZsVRxNWnOOqCynaPubjUVjxhsjFTKrFJGEMm3/0KGmNQ+Pg" defer></script>
  </head>
  <body hx-boost="true" hx-ext="response-targets">
    <header class="topbar">
      <a class="brand" href="/">kauppa</a>
      {{!-- MB-0040: on phones the nav is a native popover panel opened by
      the menu button (no JavaScript); on wide screens app.css shows it
      inline and hides both buttons. Boosted navigation swaps <body>, so
      choosing an entry leaves the panel closed. --}}
      <button type="button" class="nav-open" popovertarget="site-nav"><span class="nav-icon" aria-hidden="true">☰</span> Menu</button>
      <nav id="site-nav" class="site-nav" popover aria-label="Main">
        <button type="button" class="nav-close" popovertarget="site-nav" popovertargetaction="hide" aria-label="Close menu" autofocus>✕</button>
        <a href="/lists"{{#if page_nav}}{{#if (eq page_nav "lists")}} aria-current="page"{{/if}}{{/if}}>Lists</a>
        <a href="/recipes"{{#if page_nav}}{{#if (eq page_nav "recipes")}} aria-current="page"{{/if}}{{/if}}>Recipes</a>
        <a href="/favorites"{{#if page_nav}}{{#if (eq page_nav "favorites")}} aria-current="page"{{/if}}{{/if}}>Favorites</a>
        <a href="/categories"{{#if page_nav}}{{#if (eq page_nav "categories")}} aria-current="page"{{/if}}{{/if}}>Categories</a>
        {{#if page_signed_in}}
          <form method="post" action="/auth/logout" class="inline">
            <button type="submit" class="link">Sign out</button>
          </form>
        {{else}}
          <a href="/auth/login">Sign in</a>
        {{/if}}
      </nav>
    </header>
    <main>
      {{> @partial-block}}
    </main>
  </body>
</html>
