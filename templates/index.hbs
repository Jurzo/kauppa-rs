{{#> layout page_title="Home" page_signed_in=signed_in}}
<section class="hero">
  <h1>kauppa</h1>
  <p>Shopping lists and recipes, built with Rust and htmx.</p>
  {{#unless signed_in}}
    <p>
      <a class="button primary" href="/auth/login">Sign in</a>
    </p>
    <p class="muted">Accounts are by invitation.</p>
  {{else}}
    <p>
      <a class="button primary" href="/lists">Your lists</a>
      <a class="button" href="/recipes">Your recipes</a>
    </p>
  {{/unless}}
</section>
{{/layout}}
