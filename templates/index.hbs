{{#> layout page_title=(t "home.title") page_signed_in=signed_in}}
<section class="hero">
  <h1>kauppalista.app</h1>
  <p>{{t "home.tagline"}}</p>
  {{#unless signed_in}}
    <p>
      <a class="button primary" href="/auth/login">{{t "auth.sign_in"}}</a>
    </p>
    <p class="muted">{{t "home.invite_only"}}</p>
  {{else}}
    <p>
      <a class="button primary" href="/lists">{{t "home.your_lists"}}</a>
      <a class="button" href="/recipes">{{t "home.your_recipes"}}</a>
    </p>
  {{/unless}}
</section>
{{/layout}}
