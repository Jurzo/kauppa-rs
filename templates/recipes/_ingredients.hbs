<div id="ingredients" class="ingredients">
  {{#if error}}
    <p class="error" role="alert">{{error}}</p>
  {{/if}}

  <ul class="product-list">
    {{#each items}}
      <li class="product-row">
        <span class="product-name">
          {{#if this.quantity}}<span class="ingredient-quantity">{{this.quantity}}</span> {{/if}}{{this.name}}
          {{#if this.category}}<span class="muted">· {{this.category}}</span>{{/if}}
        </span>
        <form class="row-actions" method="post" action="/recipes/{{../recipe_id}}/ingredients/{{this.id}}/move"
              hx-post="/recipes/{{../recipe_id}}/ingredients/{{this.id}}/move" hx-target="#ingredients" hx-swap="outerHTML">
          <button id="ingredient-{{this.id}}-up" type="submit" class="link" name="dir" value="up"
                  aria-label="{{t "common.move_up" name=this.name}}"{{#if @first}} disabled{{/if}}>↑</button>
          <button id="ingredient-{{this.id}}-down" type="submit" class="link" name="dir" value="down"
                  aria-label="{{t "common.move_down" name=this.name}}"{{#if @last}} disabled{{/if}}>↓</button>
        </form>
        <details class="product-edit">
          <summary>{{t "common.edit"}}<span class="visually-hidden"> {{this.name}}</span></summary>
          <form method="post" action="/recipes/{{../recipe_id}}/ingredients/{{this.id}}/quantity"
                hx-post="/recipes/{{../recipe_id}}/ingredients/{{this.id}}/quantity" hx-target="#ingredients" hx-swap="outerHTML">
            <label>{{t "common.quantity"}}
              <input name="quantity" type="text" autocomplete="off" value="{{this.quantity}}" />
            </label>
            <button type="submit" class="button">{{t "common.save"}}</button>
          </form>
          <form method="post" action="/recipes/{{../recipe_id}}/ingredients/{{this.id}}/delete"
                hx-post="/recipes/{{../recipe_id}}/ingredients/{{this.id}}/delete" hx-target="#ingredients" hx-swap="outerHTML">
            <button type="submit" class="link danger">{{t "common.remove"}}</button>
          </form>
        </details>
      </li>
    {{else}}
      <li class="product-row empty">{{t "recipes.no_ingredients"}}</li>
    {{/each}}
  </ul>

  {{#if has_categories}}
    <form class="add-product" method="post" action="/recipes/{{recipe_id}}/ingredients"
          hx-post="/recipes/{{recipe_id}}/ingredients" hx-target="#ingredients" hx-swap="outerHTML">
      {{#if add.prompt}}
        <p id="category-prompt" class="category-prompt" role="status">{{t "recipes.new_product_prompt" name=add.prompt.name}}</p>
      {{/if}}
      <label>{{t "recipes.ingredient"}}
        <input id="new-ingredient-name" name="name" type="text" required
               autocomplete="off" placeholder="{{t "recipes.ingredient_placeholder"}}" value="{{add.name}}"
               list="ingredient-suggestions" aria-describedby="ingredient-match"
               hx-get="/recipes/{{recipe_id}}/ingredients/match" hx-trigger="input changed delay:300ms"
               hx-target="#ingredient-match" hx-swap="outerHTML" />
      </label>
      <label>{{t "common.quantity"}}
        <input name="quantity" type="text" autocomplete="off" placeholder="{{t "recipes.quantity_placeholder"}}"
               value="{{add.quantity}}" />
      </label>
      {{#if add.prompt}}
        {{!-- MB-0039: asked only after the server found the name is new. --}}
        <label>{{t "common.category"}}
          {{> products/_category_picker add.prompt.picker }}
        </label>
        <button type="submit" class="button primary">{{t "common.add"}}</button>
        <a href="/recipes/{{recipe_id}}">{{t "common.cancel"}}</a>
      {{else}}
        <button type="submit" class="button primary">{{t "common.add"}}</button>
      {{/if}}
      {{> recipes/_match_hint add.hint }}
    </form>
  {{else}}
    <p class="empty">{{t "recipes.needs_category"}}
      <a href="/categories">{{t "common.create_category_lower"}}</a>{{t "common.first"}}</p>
  {{/if}}
</div>
