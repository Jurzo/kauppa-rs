<form id="recipe-details" class="recipe-details" method="post" action="/recipes/{{id}}"
      hx-post="/recipes/{{id}}" hx-target="#recipe-details" hx-swap="outerHTML">
  {{#if error}}
    <p class="error" role="alert">{{error}}</p>
  {{/if}}
  <label>{{t "recipes.title_label"}}
    <input name="title" type="text" required value="{{title}}" />
  </label>
  <label>{{t "recipes.servings"}}
    <input name="servings" type="number" min="1" step="1" inputmode="numeric" value="{{servings}}" />
  </label>
  <label class="recipe-instructions">{{t "recipes.instructions"}}
    <textarea name="instructions" rows="6">{{instructions}}</textarea>
  </label>
  <button type="submit" class="button primary">{{t "common.save"}}</button>
  {{#if saved}}<p class="muted" role="status">{{t "recipes.saved"}}</p>{{/if}}
</form>
