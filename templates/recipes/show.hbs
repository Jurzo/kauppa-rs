{{#> layout page_title=title page_signed_in=true}}
<section>
  <header class="section-header">
    <h1>{{title}}</h1>
    <a href="/recipes">All recipes</a>
  </header>

  {{> recipes/_details details }}

  <h2>Ingredients</h2>
  {{> recipes/_ingredients ingredients }}

  <h2>Add to a list</h2>
  {{> recipes/_add_to_list add_to_list }}
</section>
{{/layout}}
