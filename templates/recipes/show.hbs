{{#> layout page_title=title page_signed_in=true}}
<section>
  <header class="section-header">
    <h1>{{title}}</h1>
    <a href="/recipes">All recipes</a>
  </header>

  {{> recipes/_details details }}

  <h2>Ingredients</h2>
  {{> recipes/_ingredients ingredients }}

  <form class="recipe-delete" method="post" action="/recipes/{{details.id}}/delete"
        hx-post="/recipes/{{details.id}}/delete" hx-target="this" hx-swap="none"
        hx-confirm="Delete the recipe “{{title}}” and its ingredients? The products stay in your catalog.">
    <button type="submit" class="link danger">Delete recipe</button>
  </form>
</section>
{{/layout}}
