<form id="new-recipe" class="add-product" method="post" action="/recipes"
      hx-post="/recipes" hx-target="#new-recipe" hx-swap="outerHTML">
  {{#if error}}
    <p class="error" role="alert">{{error}}</p>
  {{/if}}
  <label>{{t "recipes.new"}}
    <input id="new-recipe-title" name="title" type="text" required
           autocomplete="off" placeholder="{{t "recipes.title_placeholder"}}" value="{{title}}" />
  </label>
  <button type="submit" class="button primary">{{t "common.create"}}</button>
</form>
