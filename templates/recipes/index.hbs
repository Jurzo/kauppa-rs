{{#> layout title="Recipes" signed_in=true}}
<section>
  <header class="section-header">
    <h1>Recipes</h1>
  </header>

  {{> recipes/_new new }}

  <div id="recipe-grid" class="grid">
    {{#each recipes}}
      <article class="card">
        <h2><a href="/recipes/{{this.id}}">{{this.title}}</a></h2>
        {{#if this.servings}}<p class="muted">Serves {{this.servings}}</p>{{/if}}
      </article>
    {{else}}
      <p class="empty">No recipes yet. Name your first one above.</p>
    {{/each}}
  </div>
</section>
{{/layout}}
