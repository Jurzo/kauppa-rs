{{#> layout page_title=(t "recipes.title") page_signed_in=true page_nav="recipes"}}
<section>
  <header class="section-header">
    <h1>{{t "recipes.title"}}</h1>
  </header>

  {{> recipes/_new new }}

  <div id="recipe-grid" class="grid">
    {{#each recipes}}
      <article class="card">
        <h2><a href="/recipes/{{this.id}}">{{this.title}}</a></h2>
        {{#if this.servings}}<p class="muted">{{t "recipes.serves" count=this.servings}}</p>{{/if}}
      </article>
    {{else}}
      <p class="empty">{{t "recipes.empty"}}</p>
    {{/each}}
  </div>
</section>
{{/layout}}
