{{#> layout page_title=name page_signed_in=true page_nav="lists"}}
<section>
  <header class="section-header">
    <h1>{{t "sharing.heading" name=name}}</h1>
    <a href="/lists/{{id}}">{{t "sharing.back"}}</a>
  </header>
  <p class="muted">{{t "sharing.intro"}}</p>

  {{> lists/_share_form form }}
  {{> lists/_grantees grantees }}
</section>
{{/layout}}
