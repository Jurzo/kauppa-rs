<div id="grantees-{{id}}" class="grantees">
  <h2>{{t "sharing.people" count=count}}</h2>
  <ul class="product-list">
    {{#each shares}}
      <li class="product-row">
        <span class="product-name">
          {{this.name}}
          <span class="muted">{{this.email}} · {{#if this.can_edit}}{{t "sharing.can_edit_items"}}{{else}}{{t "sharing.can_view"}}{{/if}}</span>
        </span>
        <form class="row-actions" method="post" action="/lists/{{../id}}/shares/{{this.id}}/revoke"
              hx-post="/lists/{{../id}}/shares/{{this.id}}/revoke" hx-target="#grantees-{{../id}}" hx-swap="outerHTML"
              hx-confirm="{{t "sharing.revoke_confirm" name=this.name}}">
          <button type="submit" class="link danger">{{t "sharing.revoke"}}<span class="visually-hidden"> {{this.name}}</span></button>
        </form>
      </li>
    {{else}}
      <li class="product-row empty">{{t "sharing.none"}}</li>
    {{/each}}
  </ul>
</div>
