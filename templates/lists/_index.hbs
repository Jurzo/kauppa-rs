<div id="lists" class="lists">
  {{#if error}}
    <p class="error" role="alert">{{error}}</p>
  {{/if}}

  <form class="add-category" method="post" action="/lists"
        hx-post="/lists" hx-target="#lists" hx-swap="outerHTML">
    <label>{{t "lists.new"}}
      <input id="new-list" name="name" type="text" required
             autocomplete="off" placeholder="{{t "lists.placeholder"}}" value="{{draft_name}}" />
    </label>
    <button type="submit" class="button primary">{{t "common.create"}}</button>
  </form>

  <ul class="product-list">
    {{#each lists}}
      <li class="product-row">
        <a class="product-name" href="/lists/{{this.id}}">{{this.name}}</a>
        <span class="muted">{{this.updated}}</span>
        <details class="product-edit">
          <summary>{{t "common.edit"}}<span class="visually-hidden"> {{this.name}}</span></summary>
          <form method="post" action="/lists/{{this.id}}/rename"
                hx-post="/lists/{{this.id}}/rename" hx-target="#lists" hx-swap="outerHTML">
            <label>{{t "common.name"}}
              <input name="name" type="text" required value="{{this.name}}" />
            </label>
            <button type="submit" class="button">{{t "common.rename"}}</button>
          </form>
          <form method="post" action="/lists/{{this.id}}/delete"
                hx-post="/lists/{{this.id}}/delete" hx-target="#lists" hx-swap="outerHTML"
                hx-confirm="{{t "lists.delete_confirm" name=this.name}}">
            <button type="submit" class="link danger">{{t "common.delete"}}</button>
          </form>
        </details>
      </li>
    {{else}}
      <li class="product-row empty">{{t "lists.empty"}}</li>
    {{/each}}
  </ul>

  {{#if shared}}
    <h2>{{t "lists.shared_with_you"}}</h2>
    <ul class="product-list">
      {{#each shared}}
        <li class="product-row">
          <a class="product-name" href="/lists/{{this.id}}">{{this.name}}</a>
          <span class="muted">{{this.owner_name}} · {{#if this.can_edit}}{{t "sharing.can_edit_items"}}{{else}}{{t "lists.view_only"}}{{/if}} · {{this.updated}}</span>
        </li>
      {{/each}}
    </ul>
  {{/if}}
</div>
