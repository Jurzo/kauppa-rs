<div id="lists" class="lists">
  {{#if error}}
    <p class="error" role="alert">{{error}}</p>
  {{/if}}

  <form class="add-category" method="post" action="/lists"
        hx-post="/lists" hx-target="#lists" hx-swap="outerHTML">
    <label>{{t "lists.new"}}
      <input id="new-list" name="name" type="text" required
             autocomplete="off" placeholder="{{t "lists.placeholder"}}" value="{{draft_name}}" />
    </label>
    <button type="submit" class="button primary">{{t "common.create"}}</button>
  </form>

  <ul class="product-list">
    {{#each lists}}
      <li class="product-row">
        <a class="product-name" href="/lists/{{this.id}}">{{this.name}}</a>
        <span class="muted">{{this.updated}}</span>
        <details class="product-edit">
          <summary>{{t "common.edit"}}<span class="visually-hidden"> {{this.name}}</span></summary>
          <form method="post" action="/lists/{{this.id}}/rename"
                hx-post="/lists/{{this.id}}/rename" hx-target="#lists" hx-swap="outerHTML">
            <label>{{t "common.name"}}
              <input name="name" type="text" required value="{{this.name}}" />
            </label>
            <button type="submit" class="button">{{t "common.rename"}}</button>
          </form>
          <form method="post" action="/lists/{{this.id}}/delete"
                hx-post="/lists/{{this.id}}/delete" hx-target="#lists" hx-swap="outerHTML"
                hx-confirm="{{t "lists.delete_confirm" name=this.name}}">
            <button type="submit" class="link danger">{{t "common.delete"}}</button>
          </form>
          {{!-- MB-0062: archiving moves the list to the Archived section. --}}
          <form method="post" action="/lists/{{this.id}}/archive"
                hx-post="/lists/{{this.id}}/archive" hx-target="#lists" hx-swap="outerHTML">
            <button type="submit" class="link">{{t "lists.archive"}}<span class="visually-hidden"> {{this.name}}</span></button>
          </form>
        </details>
      </li>
    {{else}}
      <li class="product-row empty">{{t "lists.empty"}}</li>
    {{/each}}
  </ul>

  {{#if shared}}
    <h2>{{t "lists.shared_with_you"}}</h2>
    <ul class="product-list">
      {{#each shared}}
        <li class="product-row">
          <a class="product-name" href="/lists/{{this.id}}">{{this.name}}</a>
          <span class="muted">{{this.owner_name}} · {{#if this.can_edit}}{{t "sharing.can_edit_items"}}{{else}}{{t "lists.view_only"}}{{/if}} · {{this.updated}}</span>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if archived}}
    {{!-- MB-0062 (RR-0045): archived lists, own and shared, most recently archived first; closed unless an action happened inside. --}}
    <details id="archived-lists" class="archived-lists"{{#if archived_open}} open{{/if}}>
      <summary><span class="group-name">{{t "lists.archived"}}</span> <span class="group-count">{{t "lists.archived_count" count=archived_count}}</span></summary>
      <ul class="product-list">
        {{#each archived}}
          <li class="product-row">
            <a class="product-name" href="/lists/{{this.id}}">{{this.name}}</a>
            <span class="muted">{{#unless this.is_owner}}{{this.owner_name}} · {{/unless}}{{t "lists.archived_on" date=this.archived}}</span>
            {{#if this.is_owner}}
            <form class="row-actions" method="post" action="/lists/{{this.id}}/unarchive"
                  hx-post="/lists/{{this.id}}/unarchive" hx-target="#lists" hx-swap="outerHTML">
              <button type="submit" class="link">{{t "lists.restore"}}<span class="visually-hidden"> {{this.name}}</span></button>
            </form>
            <details class="product-edit">
              <summary>{{t "common.edit"}}<span class="visually-hidden"> {{this.name}}</span></summary>
              <form method="post" action="/lists/{{this.id}}/rename"
                    hx-post="/lists/{{this.id}}/rename" hx-target="#lists" hx-swap="outerHTML">
                <label>{{t "common.name"}}
                  <input name="name" type="text" required value="{{this.name}}" />
                </label>
                <button type="submit" class="button">{{t "common.rename"}}</button>
              </form>
              <form method="post" action="/lists/{{this.id}}/delete"
                    hx-post="/lists/{{this.id}}/delete" hx-target="#lists" hx-swap="outerHTML"
                    hx-confirm="{{t "lists.delete_confirm" name=this.name}}">
                <button type="submit" class="link danger">{{t "common.delete"}}</button>
              </form>
            </details>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    </details>
  {{/if}}
</div>
