{{#> layout title="Lists" signed_in=true}}
<section>
  <header class="section-header">
    <h1>Shopping lists</h1>
    <button class="button primary"
            hx-post="/lists"
            hx-swap="afterbegin"
            hx-target="#list-grid">New list</button>
  </header>
  <div id="list-grid" class="grid">
    {{#if lists}}
      {{#each lists}}
        <article class="card">
          <h2>{{this.name}}</h2>
          <p class="muted">Updated {{this.updated_at}}</p>
        </article>
      {{/each}}
    {{else}}
      <p class="empty">No lists yet. Create your first one.</p>
    {{/if}}
  </div>
</section>
{{/layout}}
