<div id="share-form-{{id}}" class="share-form">
  {{#if error}}
    <p class="error" role="alert">{{error}}</p>
  {{/if}}
  {{#if notice}}
    <p class="notice" role="status">{{t "sharing.notice"}}</p>
  {{/if}}

  <form class="add-product" method="post" action="/lists/{{id}}/shares"
        hx-post="/lists/{{id}}/shares" hx-target="#share-form-{{id}}" hx-swap="outerHTML">
    <label>{{t "auth.email"}}
      <input name="email" type="email" required autocomplete="off"
             placeholder="{{t "sharing.email_placeholder"}}" value="{{email}}" />
    </label>
    <label>{{t "sharing.access"}}
      <select name="role">
        <option value="view"{{#unless edit_selected}} selected{{/unless}}>{{t "sharing.option_view"}}</option>
        <option value="edit"{{#if edit_selected}} selected{{/if}}>{{t "sharing.option_edit"}}</option>
      </select>
    </label>
    <button type="submit" class="button primary">{{t "sharing.share"}}</button>
  </form>
</div>
