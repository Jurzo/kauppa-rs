{{#> layout page_title=name page_signed_in=true page_nav="lists"}}
{{!-- MB-0057 (RR-0049): as lists/show; the shopping view has no text
fields and is swapped whole. --}}
<section sse-connect="/lists/{{id}}/events?tab={{live.tab}}&amp;since={{live.since}}" sse-close="stop" hx-headers='{"X-Live-Tab":"{{live.tab}}"}'>
  <div hidden hx-get="/lists/{{id}}/shop" hx-trigger="sse:changed" hx-target="#shop-{{id}}" hx-swap="outerHTML"></div>
  <header class="section-header">
    <h1>{{name}}</h1>
    <a href="/lists/{{id}}">{{t "shop.edit_list"}}</a>
  </header>

  {{> lists/_shop }}
</section>
{{/layout}}
