{{#> layout page_title=list.name page_signed_in=true page_nav="lists"}}
<section>
  <header class="section-header">
    <h1>{{list.name}}</h1>
    <a href="/lists">{{t "lists.all"}}</a>
    {{#if list.is_owner}}<a href="/lists/{{list.id}}/sharing">{{t "sharing.share"}}</a>{{/if}}
    {{!-- MB-0060 (RR-0047): anyone who can open the list adds its items to their own favorites. --}}
    <form class="export-form" method="post" action="/lists/{{list.id}}/export">
      <button type="submit" class="button">{{t "export.button"}}</button>
    </form>
    <a class="button" href="/lists/{{list.id}}/shop">{{t "lists.go_shopping"}}</a>
  </header>

  {{> lists/_list list }}
  {{#if list.is_owner}}
  {{!-- MB-0036: the add field's suggestions (list="…"), the owner's
        favorites. Outside #list-{id} so htmx swaps don't re-send them. --}}
  <datalist id="favorite-suggestions">
    {{#each suggestions}}
      <option value="{{this}}"></option>
    {{/each}}
  </datalist>
  {{/if}}
</section>
{{/layout}}
