{{#> layout page_title=list.name page_signed_in=true page_nav="lists"}}
<section>
  <header class="section-header">
    <h1>{{list.name}}</h1>
    <a href="/lists">All lists</a>
    {{#if list.is_owner}}<a href="/lists/{{list.id}}/sharing">Share</a>{{/if}}
    <a class="button primary" href="/lists/{{list.id}}/shop">Go shopping</a>
  </header>

  {{> lists/_list list }}
  {{#if list.is_owner}}
  {{!-- MB-0036: the add field's suggestions (list="…"), the owner's
        favorites. Outside #list-{id} so htmx swaps don't re-send them. --}}
  <datalist id="favorite-suggestions">
    {{#each suggestions}}
      <option value="{{this}}"></option>
    {{/each}}
  </datalist>
  {{/if}}
</section>
{{/layout}}
