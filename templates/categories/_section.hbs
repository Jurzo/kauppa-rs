<div id="categories" class="categories">
  {{#if error}}
    <p class="error" role="alert">{{error}}</p>
  {{/if}}

  <form class="add-category" method="post" action="/categories"
        hx-post="/categories" hx-target="#categories" hx-swap="outerHTML">
    <label>{{t "categories.new"}}
      <input id="new-category" name="name" type="text" required
             autocomplete="off" placeholder="{{t "categories.placeholder"}}" value="{{draft_name}}" />
    </label>
    <button type="submit" class="button primary">{{t "common.add"}}</button>
  </form>

  <ul class="category-list">
    {{#each categories}}
      <li class="category-row">
        <form class="category-rename" method="post" action="/categories/{{this.id}}/rename"
              hx-post="/categories/{{this.id}}/rename" hx-target="#categories" hx-swap="outerHTML">
          <label class="visually-hidden" for="cat-{{this.id}}">{{t "categories.name_of" name=this.name}}</label>
          <input id="cat-{{this.id}}" name="name" type="text" required value="{{this.name}}" />
          <button type="submit" class="link">{{t "common.rename"}}</button>
        </form>
        <form class="row-actions" method="post" action="/categories/{{this.id}}/move"
              hx-post="/categories/{{this.id}}/move" hx-target="#categories" hx-swap="outerHTML">
          <button id="category-{{this.id}}-up" type="submit" class="link" name="dir" value="up"
                  aria-label="{{t "common.move_up" name=this.name}}"{{#if @first}} disabled{{/if}}>↑</button>
          <button id="category-{{this.id}}-down" type="submit" class="link" name="dir" value="down"
                  aria-label="{{t "common.move_down" name=this.name}}"{{#if @last}} disabled{{/if}}>↓</button>
        </form>
        <form class="row-actions" method="post" action="/categories/{{this.id}}/delete"
              hx-post="/categories/{{this.id}}/delete" hx-target="#categories" hx-swap="outerHTML"
              hx-confirm="{{t "common.delete_confirm" name=this.name}}">
          <button type="submit" class="link danger" aria-label="{{t "common.delete_named" name=this.name}}">{{t "common.delete"}}</button>
        </form>
      </li>
    {{else}}
      <li class="empty">{{t "categories.empty"}}</li>
    {{/each}}
  </ul>
</div>
