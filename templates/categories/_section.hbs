<div id="categories" class="categories">
  {{#if error}}
    <p class="error" role="alert">{{error}}</p>
  {{/if}}

  <form class="add-category" method="post" action="/categories"
        hx-post="/categories" hx-target="#categories" hx-swap="outerHTML">
    <label>{{t "categories.new"}}
      <input id="new-category" name="name" type="text" required
             autocomplete="off" placeholder="{{t "categories.placeholder"}}" value="{{draft_name}}" />
    </label>
    <button type="submit" class="button primary">{{t "common.add"}}</button>
  </form>

  {{!-- MB-0066 (RR-0053): dragging a row's handle posts the whole new order. The rows' hidden ids join this form through their `form` attribute (rows hold forms of their own). --}}
  <form id="category-order" class="sortable-order" method="post" action="/categories/order"
        hx-post="/categories/order" hx-target="#categories" hx-swap="outerHTML"
        hx-trigger="end from:#category-list"></form>
  <ul id="category-list" class="category-list" data-sortable>
    {{#each categories}}
      {{!-- MB-0068 (RR-0055): one line on a phone: handle, name, ↑ above ↓, a pencil that opens the rename panel below, a trash button. --}}
      <li class="category-row reorder-row">
        <input type="hidden" name="id" value="{{this.id}}" form="category-order" />
        <span class="drag-handle" role="img" aria-label="{{t "common.drag_to_reorder" name=this.name}}">⠿</span>
        <span class="row-name">{{this.name}}</span>
        <form class="row-move" method="post" action="/categories/{{this.id}}/move"
              hx-post="/categories/{{this.id}}/move" hx-target="#categories" hx-swap="outerHTML">
          <button id="category-{{this.id}}-up" type="submit" class="link" name="dir" value="up"
                  aria-label="{{t "common.move_up" name=this.name}}"{{#if @first}} disabled{{/if}}>↑</button>
          <button id="category-{{this.id}}-down" type="submit" class="link" name="dir" value="down"
                  aria-label="{{t "common.move_down" name=this.name}}"{{#if @last}} disabled{{/if}}>↓</button>
        </form>
        <details class="row-edit">
          <summary class="link icon-button" aria-label="{{t "common.rename_named" name=this.name}}">{{> icons/_pencil}}</summary>
          <form class="category-rename" method="post" action="/categories/{{this.id}}/rename"
                hx-post="/categories/{{this.id}}/rename" hx-target="#categories" hx-swap="outerHTML">
            <label class="visually-hidden" for="cat-{{this.id}}">{{t "categories.name_of" name=this.name}}</label>
            <input id="cat-{{this.id}}" name="name" type="text" required value="{{this.name}}" />
            <button type="submit" class="button">{{t "common.rename"}}</button>
          </form>
        </details>
        <form class="row-delete" method="post" action="/categories/{{this.id}}/delete"
              hx-post="/categories/{{this.id}}/delete" hx-target="#categories" hx-swap="outerHTML"
              hx-confirm="{{t "common.delete_confirm" name=this.name}}">
          <button type="submit" class="link danger icon-button" aria-label="{{t "common.delete_named" name=this.name}}">{{> icons/_trash}}</button>
        </form>
      </li>
    {{else}}
      <li class="empty">{{t "categories.empty"}}</li>
    {{/each}}
  </ul>
</div>
