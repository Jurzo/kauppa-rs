{{!-- MB-0059 (RR-0044): one favorites group, closed unless an action touched it. Actions inside target the group; the server retargets to #favorites when they leave it. --}}
<details id="{{dom_id}}" class="product-group catalog-unit"{{#if open}} open{{/if}}>
  <summary><span class="group-name">{{#if name}}{{name}}{{else}}{{t "common.uncategorized"}}{{/if}}</span> <span class="group-count">{{t "products.group_count" count=count}}</span></summary>
  {{!-- MB-0066 (RR-0053): dragging a row's handle posts the group's new order. --}}
  <form id="{{dom_id}}-order" class="sortable-order" method="post" action="/favorites/order"
        hx-post="/favorites/order" hx-target="closest .catalog-unit" hx-swap="outerHTML"
        hx-trigger="end from:#{{dom_id}}-list">
    <input type="hidden" name="category" value="{{order_key}}" />
  </form>
  <ul id="{{dom_id}}-list" class="product-list" data-sortable>
    {{#each products}}
      {{!-- MB-0068 (RR-0055): one line on a phone; the pencil opens the edit panel below the row, the trash deletes. --}}
      <li class="product-row reorder-row">
        <input type="hidden" name="id" value="{{this.id}}" form="{{../dom_id}}-order" />
        <span class="drag-handle" role="img" aria-label="{{t "common.drag_to_reorder" name=this.name}}">⠿</span>
        <span class="product-name row-name">{{this.name}}</span>
        <form class="row-move" method="post" action="/favorites/{{this.id}}/move"
              hx-post="/favorites/{{this.id}}/move" hx-target="closest .catalog-unit" hx-swap="outerHTML">
          <button id="product-{{this.id}}-up" type="submit" class="link" name="dir" value="up"
                  aria-label="{{t "common.move_up" name=this.name}}"{{#if @first}} disabled{{/if}}>↑</button>
          <button id="product-{{this.id}}-down" type="submit" class="link" name="dir" value="down"
                  aria-label="{{t "common.move_down" name=this.name}}"{{#if @last}} disabled{{/if}}>↓</button>
        </form>
        <details class="row-edit">
          <summary class="link icon-button" aria-label="{{t "common.edit_named" name=this.name}}">{{> icons/_pencil}}</summary>
          {{> products/_product_form this }}
          {{#if this.recipe_count}}
            <p class="muted">{{t "products.delete_warning" count=this.recipe_count}}</p>
          {{/if}}
        </details>
        <form class="row-delete" method="post" action="/favorites/{{this.id}}/delete"
              hx-post="/favorites/{{this.id}}/delete" hx-target="closest .catalog-unit" hx-swap="outerHTML"
              hx-confirm="{{t "common.delete_confirm" name=this.name}}{{#if this.recipe_count}} {{t "products.delete_warning" count=this.recipe_count}}{{/if}}">
          <button type="submit" class="link danger icon-button" aria-label="{{t "common.delete_named" name=this.name}}">{{> icons/_trash}}</button>
        </form>
      </li>
    {{/each}}
  </ul>
</details>
