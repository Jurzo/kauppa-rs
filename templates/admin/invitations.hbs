{{#> layout page_title=(t "invitations.title") page_signed_in=true}}
{{!-- RR-0018: a new invitation's one-time link is in this page's HTML, so
htmx never snapshots it into its history cache; Back refetches. --}}
<section hx-history="false">
  <header class="section-header">
    <h1>{{t "invitations.title"}}</h1>
  </header>
  <p class="muted">{{t "invitations.intro"}}</p>

  {{#if created}}
    <div class="invite-created" role="status">
      <p><strong>{{#if created.note}}{{t "invitations.created_with_note" note=created.note}}{{else}}{{t "invitations.created"}}{{/if}}</strong> {{t "invitations.copy_now" expires=created.expires}}</p>
      <label>{{t "invitations.link"}}
        <input class="invite-link" type="text" readonly value="{{created.link}}" />
      </label>
    </div>
  {{/if}}

  {{#if error}}
    <p class="error" role="alert">{{error}}</p>
  {{/if}}
  <form class="add-product" method="post" action="/admin/invitations"
        hx-target-4xx="body">
    <label>{{t "invitations.note_label"}}
      <input name="note" type="text" maxlength="200" autocomplete="off"
             placeholder="{{t "invitations.note_placeholder"}}" value="{{note}}" />
    </label>
    <button type="submit" class="button primary">{{t "invitations.create"}}</button>
  </form>

  <h2>{{t "invitations.all" count=count}}</h2>
  <ul class="product-list">
    {{#each invitations}}
      <li class="product-row">
        <span class="product-name">
          {{#if this.note}}{{this.note}}{{else}}<span class="muted">{{t "invitations.no_note"}}</span>{{/if}}
          <span class="muted">· {{this.state}}</span>
          <span class="muted invite-meta">
            {{t "invitations.created_at" at=this.created}}
            {{#if this.used}}
              {{#if this.used_by}}{{t "invitations.used_by" at=this.used name=this.used_by.display_name email=this.used_by.email}}{{else}}{{t "invitations.used_at" at=this.used}}{{/if}}
            {{else}}
              {{t "invitations.expires_at" at=this.expires}}
            {{/if}}
          </span>
        </span>
        {{#if this.pending}}
          <form class="row-actions" method="post" action="/admin/invitations/{{this.id}}/revoke"
                hx-confirm="{{t "invitations.revoke_confirm"}}">
            <button type="submit" class="link danger">{{t "invitations.revoke"}}<span class="visually-hidden"> {{#if this.note}}{{t "invitations.revoke_hidden_note" note=this.note}}{{else}}{{t "invitations.revoke_hidden"}}{{/if}}</span></button>
          </form>
        {{/if}}
      </li>
    {{else}}
      <li class="product-row empty">{{t "invitations.empty"}}</li>
    {{/each}}
  </ul>
</section>
{{/layout}}
